  {
   "line": 19009,
   "text": "Builds a cosmetic slot button with title and hover tween; wrap/charm previews use cached viewports"
  },
  {
   "line": 19108,
   "text": "Unused copy of the slot builder that references undefined globals"
  },
  {
   "line": 19155,
   "text": "Sets an image label to the high-res viewmodel image of a weapon's chosen skin"
  },
  {
   "line": 19167,
   "text": "Rebuilds item data with chosen cosmetics and replays ItemRemoved/ItemAdded to re-apply them"
  },
  {
   "line": 19176,
   "text": "Calls every Replicate.OnClientEvent handler directly with a ReplicationChanged payload"
  },
  {
   "line": 19239,
   "text": "Default cosmetic settings for every ownable weapon"
  },
  {
   "line": 19257,
   "text": "Refreshes the cosmetic grid for the selected weapon and mode, applying filters and highlights"
  },
  {
   "line": 19280,
   "text": "Create this weapon/mode's slots once; clicking one toggles it as the selected cosmetic"
  },
  {
   "line": 19339,
   "text": "Hide buttons left over from the previous mode or weapon"
  },
  {
   "line": 19352,
   "text": "Random slot: toggles random cosmetic selection for the selected weapon"
  },
  {
   "line": 19371,
   "text": "One slot per ownable weapon: left click selects it, right click toggles the changer for it"
  },
  {
   "line": 19427,
   "text": "Rename weapon buttons by inventory slot when items are added so loadout weapons sort first"
  },
  {
   "line": 19448,
   "text": "Buttons to apply the current selection to all weapons and to reset every weapon to defaults"
  },
  {
   "line": 19490,
   "text": "Load cosmetic settings from saved JSON, filling in missing cosmetic types"
  },
  {
   "line": 19536,
   "text": "Show/hide aimbot and silent-aim FOV circles and drive their gradient rotation"
  },
  {
   "line": 19565,
   "text": "Rebuild FOV circle stroke, outline and fill gradients from their three color pickers"
  },
  {
   "line": 19643,
   "text": "Refresh the ESP healthbar gradient when its options change"
  },
  {
   "line": 19655,
   "text": "Fire update events when ESP fill, highlight, tracer, effect, animation or skybox options change"
  },
  {
   "line": 19733,
   "text": "Mark the script finished and load the autoload config"
  },
  {
   "line": 19744,
   "text": "Runs only if asset loading failed: obfuscator junk that decodes a dummy buffer in an endless loop"
  },
  {
   "line": 19747,
   "text": "Bitwise XOR of two non-negative integers"
  },
  {
   "line": 19773,
   "text": "Extracts a single bit or a bit range from a number"
  },
  {
   "line": 19781,
   "text": "Reads four XOR-decoded bytes from the dummy buffer as a 32-bit integer"
  },
  {
   "line": 19785,
   "text": "Decodes an IEEE 754 double from two 32-bit reads"
  },
  {
   "line": 19803,
   "text": "Fills throwaway tables with decoded values forever"
  },
  {
   "line": 19846,
   "text": "Drop references to loader internals, then run a constant integrity check before erroring"
  }
 ]
