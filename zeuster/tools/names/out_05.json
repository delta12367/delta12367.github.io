   "line": 10867,
   "text": "Snapshot whitelisted properties of a model's descendants and keep them updated"
  },
  {
   "line": 10935,
   "text": "Skybox manager: stores sky presets and parents the selected one to Lighting"
  },
  {
   "line": 10983,
   "text": "Animation player presets, registered into the animation dropdown"
  },
  {
   "line": 11035,
   "text": "Weather manager: spawns a weather part whose particle emitters follow the options"
  },
  {
   "line": 11057,
   "text": "Reapply weather colors and rate/lifetime/timescale multipliers to the active emitters"
  },
  {
   "line": 11087,
   "text": "Hook emitter __index: executor Texture reads get a random id and trigger a one-time report"
  },
  {
   "line": 11112,
   "text": "Register a weather preset (BasePart) by name and add it to the weather dropdown"
  },
  {
   "line": 11140,
   "text": "Hit effects: shared 3-color sequence rebuilt whenever a hit effect color changes"
  },
  {
   "line": 11168,
   "text": "Fortnite-style damage numbers: billboard template with one frame per digit"
  },
  {
   "line": 11207,
   "text": "Show per-digit damage numbers above the hit, optionally stacking damage per target"
  },
  {
   "line": 11279,
   "text": "Fling each digit sideways and upward while fading it out"
  },
  {
   "line": 11309,
   "text": "Slashes effect: three rotated slash images that fade in, recolor and fade out"
  },
  {
   "line": 11376,
   "text": "Explosion effect: zero-radius Explosion at the hit position"
  },
  {
   "line": 11383,
   "text": "Bubble effect: attachment with two particle emitters emitted once in the hit color"
  },
  {
   "line": 11419,
   "text": "Clone effect: colored copy of the target's body parts (optionally accessories) that fades out"
  },
  {
   "line": 11498,
   "text": "Phantom Forces style damage numbers, colored by hit body part"
  },
  {
   "line": 11611,
   "text": "Spread successive numbers around the hit using the golden angle"
  },
  {
   "line": 11630,
   "text": "Load particle parts from the assets folder and register each as a hit effect"
  },
  {
   "line": 11683,
   "text": "Built-in shoot sound presets"
  },
  {
   "line": 11694,
   "text": "Give a sound table a register method that adds the name to its dropdown"
  },
  {
   "line": 11737,
   "text": "Register .mp3/.wav/.ogg files from the sounds folder as hit and shoot sounds"
  },
  {
   "line": 11757,
   "text": "Custom bullet tracers keyed by style name"
  },
  {
   "line": 11785,
   "text": "Drawing tracer: outline and gradient lines redrawn every frame until faded out"
  },
  {
   "line": 11875,
   "text": "Beam tracers: textured beams between two terrain attachments, extra copies for glow"
  },
  {
   "line": 11958,
   "text": "Draw the selected tracer on shoot, debounced unless part of a multi-ray shot"
  },
  {
   "line": 11977,
   "text": "Connect a signal only while the given toggle is enabled"
  },
  {
   "line": 11992,
   "text": "Track the screen center as the viewport resizes"
  },
  {
   "line": 11998,
   "text": "Keep a per-player table of character parts, tool and humanoid"
  },
  {
   "line": 12053,
   "text": "Mirror the spectated duel's duelers into the ESP via events"
  },
  {
   "line": 12091,
   "text": "Camera FOV override and stretched aspect ratio applied after the camera render step"
  },
  {
