  {
   "line": 17787,
   "text": "Collect non-degenerate mesh faces with their positions and normals, then remove them"
  },
  {
   "line": 17806,
   "text": "Rebuild each unique face edge as a thin two-triangle strip to draw a wireframe"
  },
  {
   "line": 17858,
   "text": "Re-apply appearance overrides whenever a view model is sent through the event"
  },
  {
   "line": 17876,
   "text": "Refresh every item's view model when any arm/viewmodel appearance option changes"
  },
  {
   "line": 17897,
   "text": "Hook SetArmsData and _UpdateWrap to re-fire the appearance event for local view models"
  },
  {
   "line": 17943,
   "text": "Swap the FramesPerSecond constant in Update to apply the view model frames override"
  },
  {
   "line": 17959,
   "text": "Redirect GetCameraSway to a wrapper that returns zero sway when sway is disabled"
  },
  {
   "line": 17980,
   "text": "Hook Gun.StartShooting to patch its returned flags for no-spread and the Revolver"
  },
  {
   "line": 18006,
   "text": "Hook PlayAnimation: cut shoot cooldown, trigger custom shoot sound, cancel shoot anim"
  },
  {
   "line": 18032,
   "text": "Skip the animator's next task.defer after a custom shoot sound was triggered"
  },
  {
   "line": 18047,
   "text": "Replace minigun shooting sounds with repeated on_sound_wanted events while firing"
  },
  {
   "line": 18080,
   "text": "Scale weapon recoil by the viewmodel_recoil percentage"
  },
  {
   "line": 18088,
   "text": "Disable muzzle flash by making pairs iterate an empty table inside MuzzleFlash"
  },
  {
   "line": 18100,
   "text": "Ignore the server BlindEffect from flashbangs when anti-flashbang is on"
  },
  {
   "line": 18113,
   "text": "Inject the chosen or random skin, charm and wrap when creating local view models"
  },
  {
   "line": 18170,
   "text": "Show the chosen skin's image in the weapon picker"
  },
  {
   "line": 18194,
   "text": "Replace the local player's finisher with the chosen or random one"
  },
  {
   "line": 18223,
   "text": "Route tracers to the custom tracer event when custom tracers are enabled"
  },
  {
   "line": 18239,
   "text": "Multiply slide walk speed by the slide boost value"
  },
  {
   "line": 18249,
   "text": "Allow double jumping while airborne when infinite double jump is on"
  },
  {
   "line": 18264,
   "text": "Patch the double jump height constant with the configured multiplier"
  },
  {
   "line": 18277,
   "text": "Patch the maul slam downward velocity constant with the configured multiplier"
  },
  {
   "line": 18292,
   "text": "Force third-person POV while the toggle and keybind are active in first person"
  },
  {
   "line": 18317,
   "text": "Auto-pick the configured loadout via PickWeapons when GetSetting runs on entity_added"
  },
  {
   "line": 18344,
   "text": "Auto-queue: leave and rejoin the selected queue mode when a duel finishes"
  },
  {
   "line": 18379,
   "text": "Auto-ban the configured weapons and a random map during duel voting"
  },
  {
   "line": 18415,
   "text": "Auto-respawn by firing RespawnNow when the respawn button animation plays"
  },
  {
   "line": 18428,
   "text": "Spoof the input device type by sending SetControls to the server"
  },
  {
   "line": 18452,
   "text": "Hook fighter ReplicateFromServer: hit effects, attacker ragebot priority, skin cache"
  },
  {
   "line": 18486,
   "text": "Optionally hide hit markers and hitmarker sounds"
  },
  {
