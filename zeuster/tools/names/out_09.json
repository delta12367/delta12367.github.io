  {
   "line": 16187,
   "text": "Each frame, place the world ESP icon on screen, size it by distance and apply the fade"
  },
  {
   "line": 16250,
   "text": "When the model is destroyed, let the fade play out, then disconnect and remove the icon"
  },
  {
   "line": 16259,
   "text": "Keep world ESP settings in sync with the UI toggles and options"
  },
  {
   "line": 16293,
   "text": "Create an ESP icon for each reported world item that is whitelisted"
  },
  {
   "line": 16300,
   "text": "Protected copies of the constant/upvalue/proto debug functions"
  },
  {
   "line": 16305,
   "text": "Copy one function's environment and debug info onto another so it mimics the original"
  },
  {
   "line": 16319,
   "text": "Hook a function through a loadstring proxy stored under a random key in its environment"
  },
  {
   "line": 16338,
   "text": "Replace a table field with a mimicking function and return the original"
  },
  {
   "line": 16348,
   "text": "Find a function constant by value, optionally overwrite it, and return its index"
  },
  {
   "line": 16359,
   "text": "Find a function upvalue by value or predicate, optionally overwrite it, and return its index"
  },
  {
   "line": 16370,
   "text": "Scan garbage-collected tables for one that passes every check"
  },
  {
   "line": 16394,
   "text": "Aimbot: rotate the game camera toward the target part every Heartbeat"
  },
  {
   "line": 16397,
   "text": "Convert a camera rotation change into a 2D delta used to push the sway springs"
  },
  {
   "line": 16432,
   "text": "Frame-rate independent lerp factor, capped at 1"
  },
  {
   "line": 16437,
   "text": "True when the humanoid is jumping, falling or standing on air"
  },
  {
   "line": 16456,
   "text": "Delayed aim: trail a tracking point behind the target with separate X/Y/jump smoothing"
  },
  {
   "line": 16622,
   "text": "Apply axis matching to the target position, then run the same smoothing steps"
  },
  {
   "line": 16798,
   "text": "Velocity movement: drive the root part along the move direction, with W/S vertical on ladders"
  },
  {
   "line": 16916,
   "text": "Fly: anchor the root part and move it with WASD/Space/C relative to the camera"
  },
  {
   "line": 16968,
   "text": "When fly stops, restore an upright orientation and turn PlatformStand back off"
  },
  {
   "line": 16981,
   "text": "Let other features move the fly anchor CFrame while flying"
  },
  {
   "line": 16991,
   "text": "Noclip: toggle collisions on the main character parts every physics step"
  },
  {
   "line": 17021,
   "text": "Chat spam: every 5 seconds send a random or sequential message from the chosen preset"
  },
  {
   "line": 17058,
   "text": "Arcade auto ammo: pull dropped ammo pickups to the player and touch them"
  },
  {
   "line": 17096,
   "text": "Triggerbot: shoot when a camera raycast hits a living enemy player's hitbox"
  },
  {
   "line": 17131,
   "text": "Delay the next shot by the reaction time plus a random offset"
  },
  {
   "line": 17165,
   "text": "Raycast forward, skipping filtered parts, until a valid enemy target or a miss"
  },
  {
   "line": 17230,
   "text": "Report thrown items to world ESP by hooking task.defer inside Throwable.ReplicateFromServer"
  },
  {
   "line": 17246,
   "text": "Report Subspace Tripmines to world ESP as they are tagged"
  },
  {
   "line": 17251,
   "text": "Silent aim: hook GetCameraData to redirect shots at the silent aim target part"
  },
  {
   "line": 17268,
   "text": "Roll against the hit chance before redirecting the shot"
  },
  {
   "line": 17285,
   "text": "Apply manipulation data: override camera/muzzle positions, offsets and hit offset"
  },
  {
   "line": 17409,
   "text": "Always backstab: send a camera CFrame behind the aimed-at character before the knife attack"
  },
  {
   "line": 17442,
   "text": "Silent aim visualize: point local tracers at the target by editing the caller's stack"
  },
  {
   "line": 17472,
   "text": "No spread: force the GetSpread flag on the tracer upvalue table"
  },
  {
   "line": 17493,
   "text": "Return the color as-is when transparency is at most 1, otherwise its inverse"
  },
  {
   "line": 17496,
   "text": "Toggle the scope aiming animation by patching the 0.375 constant in Scope.SetActive"
  },
  {
   "line": 17502,
   "text": "MoveVelocity stub whose Cross always returns zero, used to disable viewmodel tilt"
  },
  {
   "line": 17520,
   "text": "Detach the current viewmodel highlight so updated chams settings get applied"
  },
  {
   "line": 17567,
   "text": "Rebuild the viewmodel offset CFrame when the X/Y/Z sliders change"
  },
  {
