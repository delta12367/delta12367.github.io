 "comments": [
  {
   "line": 13793,
   "text": "Start reloading a gun and replicate the reload action to the server via the UseItem remote"
  },
  {
   "line": 13806,
   "text": "Ammo check: true if loaded, (nil, true) if both magazine and reserve are empty"
  },
  {
   "line": 13821,
   "text": "Track ragebot settings: swap when empty, primary weapon order and shots per attempt"
  },
  {
   "line": 13833,
   "text": "Send character to the void: set server CFrame and hide root part via PhysicsRepRootPart"
  },
  {
   "line": 13840,
   "text": "Gun ragebot: choose a usable gun, move above the target and fire StartShooting shots"
  },
  {
   "line": 13851,
   "text": "Collect guns in preferred order that still have ammo or reserve ammo to reload"
  },
  {
   "line": 13885,
   "text": "Chosen gun equipped: wait for reload/cooldown, then shoot; otherwise equip it"
  },
  {
   "line": 13907,
   "text": "Stand above the target (offset by its riot shield) and fire repeated shots at the hitbox"
  },
  {
   "line": 14002,
   "text": "Target holds a riot shield: shift 2 studs along its facing direction before shooting"
  },
  {
   "line": 14204,
   "text": "Return hitbox head, invincibility, character, fighter and name for a valid enemy player"
  },
  {
   "line": 14224,
   "text": "Ragebot priority options and helper that adds a player to the priority list"
  },
  {
   "line": 14246,
   "text": "Pick ragebot target: priority players (optionally voided players) first, then any dueler"
  },
  {
   "line": 14315,
   "text": "Ragebot tick: pick knife, melee or gun handler from the inventory and run it on the target"
  },
  {
   "line": 14389,
   "text": "Build ragebot status indicator text and update the target overlay"
  },
  {
   "line": 14414,
   "text": "Anti-aim floor hide: put server CFrame 5 studs below the real position, rotated flat"
  },
  {
   "line": 14432,
   "text": "Each Heartbeat: record client CFrame, run ragebot, then apply the desynced server CFrame"
  },
  {
   "line": 14486,
   "text": "Find the on-screen MeshPart of a character closest to the screen center, skipping hitboxes"
  },
  {
   "line": 14536,
   "text": "Each Heartbeat: pick the closest valid target inside the silent aim / aimbot FOV"
  },
  {
   "line": 14622,
   "text": "Apply forget time, reaction time and flashbang checks before keeping the target"
  },
  {
   "line": 14653,
   "text": "Publish the target to silent aim and aimbot state, then update the overlay"
  },
  {
   "line": 14680,
   "text": "ESP: shared gradient lists and the per-player ESP objects currently running"
  },
  {
   "line": 14704,
   "text": "Appearance override settings applied to enemy characters when ESP override is enabled"
  },
  {
   "line": 14720,
   "text": "Show the dueler's equipped weapon name on an ESP text drawing"
  },
  {
   "line": 14744,
   "text": "Return a check for whether the dueler's camera is looking along a given direction"
  },
  {
   "line": 14756,
   "text": "Rich-text color tags for ESP flags, refreshed when the color options change"
  },
  {
   "line": 14771,
   "text": "Rebuild the escaped flag bridge text when flag style or bridge text changes"
  },
  {
   "line": 14786,
   "text": "Per-font pixel offsets for ESP flag text"
  },
  {
   "line": 14801,
   "text": "Write fill images to disk and offer them as choices for the ESP fill image option"
  },
  {
   "line": 14828,
   "text": "ESP builder: cache ESP toggles/options and track whether any ESP element is enabled"
  }
 ]
